# See terraform-aurora-aws-environment/examples/comprehensive/bootstrap for the
# AWS remote-state root that calls this module.
#
# When calling this module directly, supply:
k8s_provider = "aws"

platform = {
  git = {
    url    = "https://github.com/gccloudone-aurora/project-<name>.git"
    branch = "main"
    path   = "clusters/non-prod/**/config.yaml"
  }
  # helm = {
  #   registry = "https://gccloudone-aurora.github.io/aurora-platform-charts"
  # }
}

github_auth = {
  pat = {
    username = "aurora-svc"
    token    = ""
  }
}

# Optional: register.clusters map (cluster name → server/token/caData).
# cluster_registration = {
#   "mgmt-dev-cc-00" = {
#     server = "https://kubernetes.default.svc.cluster.local"
#     token  = "..."
#     caData = "..." # base64-encoded CA
#   }
# }
