platform = {
  git = {
    url    = "https://github.com/gccloudone-aurora/project-aurora-mgmt.git"
    branch = "main"
    path   = "clusters/non-prod/**/config.yaml"
  }
  # helm = {
  #   registry = "https://gccloudone-aurora.github.io/aurora-platform-charts"
  # }
}

github_auth = {
  pat = {
    username = "aurora-svc"
    token    = ""
  }
}

