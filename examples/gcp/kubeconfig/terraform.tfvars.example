config_context = "" # e.g. gke_my-project_northamerica-northeast1_my-cluster
gcp_project_id = ""

platform = {
  git = {
    url    = "https://github.com/gccloudone-aurora/project-aurora-mgmt.git"
    branch = "main"
    path   = "clusters/non-prod/**/config.yaml"
  }
}

github_auth = {
  pat = {
    username = "aurora-svc"
    token    = ""
  }
}

# Optional: register.clusters map (cluster name → server/token/caData).
